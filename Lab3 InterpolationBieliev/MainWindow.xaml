<Window x:Class="InterpolationLab.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Лабораторна №3 — Інтерполяція" Width="1200" Height="820">
 <Grid Margin="12">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

  <Border BorderBrush="LightGray" BorderThickness="1" Padding="10" Margin="0,0,0,10">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="230"/><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel Grid.Column="0">
     <TextBlock Text="Крок h₁, од. X" FontWeight="Bold"/>
     <TextBox Text="{Binding H1,UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8"/>
     <TextBlock Text="Крок h₂, од. X" FontWeight="Bold"/>
     <TextBox Text="{Binding H2,UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8"/>
     <Button Content="ПОБУДУВАТИ" Command="{Binding BuildCommand}" Height="36"/>
    </StackPanel>
    <StackPanel Grid.Column="1" Margin="15,0,0,0">
     <TextBlock Text="Видимість кривих" FontWeight="Bold"/>
     <CheckBox Content="Еталонна sin(x)" IsChecked="{Binding ShowReference}" Margin="0,5"/>
     <CheckBox Content="Лінійна" IsChecked="{Binding ShowLinear}" Margin="0,5"/>
     <CheckBox Content="Ерміта" IsChecked="{Binding ShowHermite}" Margin="0,5"/>
     <CheckBox Content="Опорні A1" IsChecked="{Binding ShowSupport}" Margin="0,5"/>
    </StackPanel>
    <StackPanel Grid.Column="2" Margin="15,0,0,0">
     <CheckBox Content="Нерівновіддалені опорні точки" IsChecked="{Binding UnevenPoints}" Margin="0,5"/>
     <TextBlock Text="Функція: y = sin(x)" Margin="0,8,0,0"/>
     <TextBlock Text="Діапазон: 0 ... 2π" Foreground="Gray"/>
                    <TextBlock Text="Умова: h₂ &lt; h₁" Foreground="Gray"/>
                </StackPanel>
    <StackPanel Grid.Column="3" Margin="15,0,0,0">
     <TextBlock Text="Максимальна абсолютна похибка" FontWeight="Bold"/>
     <TextBlock Text="{Binding MaxLinearError,StringFormat=Лінійна: {0:0.000000}}"/>
     <TextBlock Text="{Binding MaxHermiteError,StringFormat=Ерміта: {0:0.000000}}"/>
    </StackPanel>
   </Grid>
  </Border>

  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
   <StackPanel>
    <TextBlock Text="Основний графік" FontWeight="Bold" FontSize="16" Margin="5"/>
    <Border BorderBrush="Gray" BorderThickness="1" Height="440">
     <Canvas Width="900" Height="420" HorizontalAlignment="Center">
      <Line X1="30" Y1="210" X2="870" Y2="210" Stroke="LightGray"/>
      <Line X1="30" Y1="30" X2="30" Y2="390" Stroke="LightGray"/>
      <Polyline Points="{Binding ReferencePoints}" Stroke="Black" StrokeThickness="2" Visibility="{Binding ShowReference,Converter={StaticResource BoolToVisibility}}"/>
      <Polyline Points="{Binding LinearPoints}" Stroke="Red" StrokeThickness="2" Visibility="{Binding ShowLinear,Converter={StaticResource BoolToVisibility}}"/>
      <Polyline Points="{Binding HermitePoints}" Stroke="Blue" StrokeThickness="2" Visibility="{Binding ShowHermite,Converter={StaticResource BoolToVisibility}}"/>
      <Polyline Points="{Binding SupportPoints}" Stroke="Green" StrokeThickness="5" Visibility="{Binding ShowSupport,Converter={StaticResource BoolToVisibility}}"/>
     </Canvas>
    </Border>

    <TextBlock Text="Графік абсолютної похибки" FontWeight="Bold" FontSize="16" Margin="5,15,5,5"/>
    <Border BorderBrush="Gray" BorderThickness="1" Height="240">
     <Canvas Width="900" Height="220" HorizontalAlignment="Center">
      <Line X1="30" Y1="190" X2="870" Y2="190" Stroke="LightGray"/>
      <Polyline Points="{Binding LinearErrorPoints}" Stroke="Red" StrokeThickness="2"/>
      <Polyline Points="{Binding HermiteErrorPoints}" Stroke="Blue" StrokeThickness="2"/>
     </Canvas>
    </Border>
   </StackPanel>
  </ScrollViewer>

  <StatusBar Grid.Row="2" Margin="0,8,0,0"><StatusBarItem><TextBlock Text="{Binding Status}"/></StatusBarItem></StatusBar>
 </Grid>
</Window>